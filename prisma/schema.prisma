// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String              @id @default(uuid())
  fullName                  String 
  email                     String              @unique
  password                  String
  location                  Json?
  profilePic                String?
  passwordChangedAt         DateTime?
  isVerified                Boolean             @default(false)
  referralCode              String              @unique
  referralCount             Int                 @default(0)
  referralsGiven            Referral[]          @relation("ReferralReferrer")
  referralsReceived         Referral[]          @relation("ReferralReferred")
  role                      UserRole            @default(USER)
  isSubscribed              Boolean             @default(false)
  planExpiration            DateTime?
  lastActiveAt              DateTime?
  coinBalance Int @default(0)
  walletBalance Float @default(0)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  Profile                   Profile?
  Subscription              Subscription?
  ntification               Notification[]
  userDrillProgress         UserDrillProgress[]
  review                    Review[]
  userUsages                UserCouponUsage[]
  playerSkillCard           PlayerSkillCard?
  drillCollection            DrillCollection[]
  order                     Order[]
  shippingAddresses         ShippingAddress?
  userBadge                 UserBadge[]
  userChallenges UserChallenge[]
  userTrainingProgress  UserTrainingProgress[]
  userLevelProgress     UserLevelProgress[]
  @@map("users")
}

model Referral {
  id             String   @id @default(uuid())

  referrerId     String
  referredUserId String   @unique

  createdAt      DateTime @default(now())

  referrer       User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser   User     @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
}




model Profile {
  id               String   @id @default(uuid())

  userId         String  @unique

  ageRange         String?

  practiceLevel    PracticeLevel?

  practiceDuration PracticeDuration?

  preferredShots   String?

  skillConfidence  Int   ?  

 createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt 
  user          User @relation(fields: [userId],references: [id],onDelete: Cascade)
}


model OtpModel {
  id          String   @id @default(uuid())
  email       String
  code        String
  isVerified  Boolean  @default(false)
  generatedAt DateTime @default(now())
  expiresAt   DateTime
}

model Plan {
  id            String         @id @default(uuid())
  planName      String
  amount        Float
  PlanType      PlanType       @default(FREE)
  planCategory  PlanCategory
  currency      String?
  interval      Interval       @default(month)
  intervalCount Int
  freeTrialDays Int?
  productId     String
  priceId       String
  active        Boolean
  description   String?
  features      Json?
  whatsOffered  Json?       
  xpReward      Int?           @default(200) 
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Subscription  Subscription[]

  @@map("plans")
}

enum PlanCategory {
 LIFETIME
PREMIUM
}

model Subscription {
  id              String               @id @default(uuid())
  userId          String               @unique
  planId          String
  startDate       DateTime
  endDate         DateTime?
  amount          Float
  stripePaymentId String               @unique
  paymentStatus   PaymentStatus        @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  plan            Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("subscriptions")
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String
  category    String
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Notification {
  id        String           @id @default(uuid())
  userId    String?
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Challenge {
  id         String    @id @default(uuid())
  name       String
  drillCount Int
  earnCoin   Int      
  startDate  DateTime
  endDate    DateTime
  ageRange   String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  challengeDrills ChallengeDrill[]
  userChallenges UserChallenge[]
  badges Badge[] 
}

model ChallengeDrill {
  id          String    @id @default(uuid())
  challengeId String
  drillId     String
  order       Int       

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  drill       Drill     @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@unique([challengeId, drillId])
}


model UserChallenge {
  id          String                @id @default(uuid())
  userId      String
  challengeId String
  status      UserChallengeStatus   @default(ONGOING)
  joinedAt    DateTime              @default(now())
  completedAt DateTime?
 createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    UserChallengeProgress[]

  @@unique([userId, challengeId])
}

enum UserChallengeStatus {
  ONGOING
  COMPLETED
  FAILED
}

model UserChallengeProgress {
  id              String        @id @default(uuid())
  userChallengeId String
  drillId         String
  isCompleted     Boolean       @default(false)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())

  userChallenge   UserChallenge @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)
  drill           Drill         @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@unique([userChallengeId, drillId])
}

model Training {
  id          String   @id @default(uuid())
  name        String
  image        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

 levels      Level[]
 badges Badge[] 
 userTrainingProgress  UserTrainingProgress[]
}


model Level {
  id          String   @id @default(uuid())
  levelNumber Int   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainingId  String
  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  
  drills      Drill[]
  userLevelProgress     UserLevelProgress[]
  badges Badge[] 
  @@unique([trainingId, levelNumber])  
}

model Drill {
  id         String   @id @default(uuid())
  name       String
  time       String
  earnCoin   String  
  video      String  
  hashtags   String[]  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  levelId    String   
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  userDrillProgress UserDrillProgress[]
  favoriteDrill FavoriteDrill[]
  challengeDrills ChallengeDrill[]
  challengeProgress UserChallengeProgress[]
}


model UserDrillProgress {
  id           String   @id @default(uuid())
  userId       String
  drillId      String
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  earnedCoins  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  drill Drill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@unique([userId, drillId]) 
}


model DrillCollection {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteDrills FavoriteDrill[]
}

model FavoriteDrill {
  id           String   @id @default(uuid())
  drillId      String
  collectionId String
  createdAt    DateTime @default(now())

  drill      Drill           @relation(fields: [drillId], references: [id], onDelete: Cascade)
  collection DrillCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, drillId])
}


model Product {
  id        String   @id @default(uuid())
  name      String  
  price     Float    
  quantity  Int      
  imageUrl  String  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItem  OrderItem []
  @@map("products")
}




model PlayerSkillCard {
  id            String   @id @default(uuid())
  userId        String @unique
  fullName      String
  image          String
  country       String
  playerNumber  Int
  playerPosition String
  favoriteClub  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

 user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}


model Coupon {
  id              String   @id @default(uuid())
  couponName      String
  couponCode      String   @unique
  discountPercent Float

  usageLimit      Int?     
  usedCount       Int      @default(0)

  startDate       DateTime
  expiryDate      DateTime

  status          CouponStatus @default(ACTIVE)
  userUsages      UserCouponUsage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model UserCouponUsage {
  id        String   @id @default(uuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId]) 
  @@index([userId])
  @@index([couponId])
}

model Order {
  id              String           @id @default(uuid())
  userId          String
  shippingId      String?
  totalAmount     Float
  shippingCost    Float
  paymentMethod   String?
  couponId        String?
  orderStatus     OrderStatus      @default(PENDING)
  paymentStatus   PaymentStatus    @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddress ShippingAddress? @relation(fields: [shippingId], references: [id])
  orderItems      OrderItem[]
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  price      Float
  totalPrice Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
model ShippingAddress {
  id            String   @id @default(uuid())
  userId        String @unique
  fullName      String
  email         String
  phone         String
  country       String
  state         String?
  city          String
  postalCode    String
  area          String?
  address       String
  specialMessage String?   // optional field
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}


