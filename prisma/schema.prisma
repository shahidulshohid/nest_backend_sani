model Badge {
  id          String        @id @default(uuid())
  name        String        @unique
  icon        String
  description String
  category    BadgeCategory
  criteriaType BadgeCriteriaType          
  isActive    Boolean       @default(true)
  rarity      BadgeRarity   @default(COMMON)
  points      Int           @default(10)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

 
  levelId      String?                    
  trainingId   String?                    
  challengeId  String?                    

  level        Level?        @relation(fields: [levelId], references: [id], onDelete: SetNull)
  training     Training?     @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  challenge    Challenge?    @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  userBadges   UserBadge[]
}

enum BadgeCriteriaType {
  LEVEL_COMPLETE
  TRAINING_COMPLETE
  CHALLENGE_COMPLETE
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  
  @@unique([userId, badgeId])
}


model UserTrainingProgress {
  id              String    @id @default(uuid())
  userId          String
  trainingId      String
  currentLevelId  String?
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  training        Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([userId, trainingId])
}

model UserLevelProgress {
  id           String    @id @default(uuid())
  userId       String
  levelId      String
  trainingId   String
  isUnlocked   Boolean   @default(false)
  isCompleted  Boolean   @default(false)
  unlockedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level        Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}


model GiftCode {
  id           String        @id @default(uuid())
  code         String        @unique
  email        String
  isUsed       Boolean       @default(false)
  usedBy       String?
  usedAt       DateTime?
  expiresAt    DateTime
  planDuration Int           @default(365)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
enum BadgeCategory {
  COMPLETION
  STREAK
  SKILL
  ACHIEVEMENT
  SPECIAL
  CHALLENGE
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELED
  REFUNDED
}


enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  ORGANIZATION
}


enum PracticeLevel {
  BEGINNER
  ADVANCED
}

enum PracticeDuration {
  LESS_THAN_1_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  FIVE_PLUS_YEARS
}

enum PreferredShot {
  INSIDE_FOOT
  OUTSIDE_FOOT
  VOLLEY
  HEADER
}

enum NotificationType {
  SUBMISSION
  FEEDBACK
  REMINDER
  SYSTEM
}

enum Interval {
  lifetime
  week
  month
  year
}
enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELED
  REFUNDED
  PAID
}
enum Status {
  PROCESSING
  COMPLETED
  FAILED
}

enum PlanType {
  FAMILY
  FREE
  PREMIUM
  LIFETIME
}